---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Composy — No-Code for creating Apps with Compose Multiplatform',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Try the demo',
        href: 'https://composy-app.pages.dev/',
        target: '_blank',
        icon: 'tabler:test-pipe',
      },
      { text: 'Join the waitlist', href: 'https://tally.so/r/n92KeQ' },
    ]}
    image={{ src: '~/assets/images/hero-image-composy.jpeg', alt: 'Composy Hero Image' }}
  >
    <Fragment slot="title">
      No-Code for <span class="hidden xl:inline">creating Apps with</span>
      <span class="text-accent dark:text-white highlight"> Compose Multiplatform</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Composy</span> is a no-code app builder that lets you create full native apps for Android, iOS, desktop and WASM with drag and drop and no code.</span
      >
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <!-- <Note /> -->

  <!-- Features Widget *************** -->

  <Features
    id="milestones"
    tagline="Milestones"
    title="Milestones"
    subtitle="We are building Composy to be the best no-code app builder for Compose Multiplatform. Follow our progress and join the waitlist to be the first to try it."
    items={[
      {
        title: 'Free Demo',
        description:
          'Try the demo and see how easy it is to create an app with Composy.',
        icon: 'tabler:test-pipe',
        badge: 'DONE',
        callToAction: {
          text: 'Try the demo',
          href: 'https://composy-app.pages.dev/',
          target: '_blank',
        },
      },
      {
        title: 'No Code',
        description:
          'No need to write a single line of code. Just drag and drop and your app is ready.',
        icon: 'tabler:code-off',
        badge: 'DOING',
      },
      {
        title: 'Multiplatform',
        description:
          'Powered by Compose Multiplatform, a modern toolkit for building native UIs for all platforms from a single codebase.',
        icon: 'tabler:brand-databricks',
        badge: 'DOING',
      },
      {
        title: 'Export to JSON',
        description:
          'Export your app or components to JSON and use them via json-to-compose library.',
        icon: 'tabler:json',
        badge: 'DOING',
        callToAction: {
          text: 'Read more',
          href: 'https://github.com/jesusdmedinac/json-to-compose',
          target: '_blank',
        }
      },
      {
        title: 'Drag & Drop',
        description:
          'Create your app by dragging and dropping components onto the canvas.',
        icon: 'tabler:hand-grab',
        badge: 'TODO',
      },
      {
        title: 'App Store',
        description:
          'Deploy your app to App Store and Google Play',
        icon: 'tabler:rocket',
        badge: 'TODO',
      },
      {
        title: 'Export/Import to Code',
        description:
          'Export your app to code and continue working on it with Android Studio or Xcode. Import your code back to Composy and continue working on it with drag and drop.',
        icon: 'tabler:arrows-right-left',
        badge: 'TODO',
      },
      {
        title: 'Server-Driven UI',
        description:
          'Create dynamic UIs that can be updated without needing to update the app.',
        icon: 'tabler:cloud',
        badge: 'TODO',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="json-to-compose"
    title="Composy is build on top of json-to-compose library"
    callToAction={{
      text: 'Read more',
      href: 'https://github.com/jesusdmedinac/json-to-compose',
      target: '_blank',
    }}
    items={[
      {
        title: 'Built on top of json-to-compose',
        description:
          'Composy is built on top of json-to-compose library, a library that allows you to create Compose UIs from JSON.',
      },
      {
        title: 'Compose Multiplatform',
        description:
          'json-to-compose supports all platforms that Compose Multiplatform supports, including Android, iOS, desktop and WASM.',
      },
      {
        title: 'Server-Driven UI',
        description:
          'Create dynamic UIs that can be updated without needing to update the app.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">The easiest way to build SDUI</h3>
      Use json-to-compose library to create dynamic UIs that can be updated without needing to update the app.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    title="Jesús Daniel Medina Cruz"
    tagline="CEO & Founder"
    subtitle="Kotlin Mobile Engineer | Android Mobile Engineer | iOS Mobile Engineer | Kotlin Expert | Compose Expert | Kotlin Multiplatform Expert | Mobile Consultant | Mobile Teacher"
    image={{
      src: '~/assets/images/jesusdmedinac.jpg',
      alt: 'Blueprint Image',
    }}
    items={[
      {
        title: 'About Jesús Daniel Medina Cruz',
        description: 'I am a skilled mobile app developer with extensive experience in Kotlin and Kotlin Multiplatform. I have over 8 years of hands-on experience building native Android applications and have successfully led Java-to-Kotlin migrations for development teams.',
        callToAction: {
          text: 'Read more',
          href: 'https://jesusdmedinac.com/',
          target: '_blank',
        }
      },
      {
        title: 'Desde0 Academy',
        description: 'Do you have an idea or project that needs a helping hand? At Desde0 Academy, we connect you with talented interns who are ready to develop your websites and mobile apps, free of charge.',
        callToAction: {
          text: 'Read more',
          href: 'https://desde0.jesusdmedinac.com/',
          target: '_blank',
        }
      },
      {
        title: 'Kotlin Multiplatform',
        description: 'Learn how to use Kotlin Multiplatform for Android and iOS, all the way to backend and frontend web development, maximizing the potential of the Kotlin language.',
        callToAction: {
          text: 'Read more',
          href: 'https://kmp.jesusdmedinac.com/',
          target: '_blank',
        }
      }
    ]}
  >
    <Fragment slot="content">
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

