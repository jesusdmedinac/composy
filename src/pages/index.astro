        href: 'https://composy-app.pages.dev/',
        target: '_blank',
        icon: 'tabler:test-pipe',
      },
      { text: 'Join the waitlist', href: 'https://tally.so/r/n92KeQ' },
    ]}
  >
    <Fragment slot="title">
      Composy<br class="block sm:hidden" /><span class="sm:whitespace-nowrap"> for Compose Multiplatform</span>
